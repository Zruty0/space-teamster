{
  "name": "space-teamster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:equipment": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs",
    "test:par": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/mission-cost.test.ts",
    "test:maintenance": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/maintenance-inspection.test.ts",
    "test:acheron": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/acheron.test.ts",
    "test:balor": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/balor.test.ts",
    "test:orbital-markers": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/orbital-markers.test.ts",
    "test:menus": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/menu-layout.test.ts",
    "test:stations": "tsc -p tsconfig.tests.json && node tests/run-equipment.mjs tests/station-layout.test.ts && node tests/run-equipment.mjs tests/parked-ships.test.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
